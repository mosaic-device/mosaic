	(text "Mosaic peripheral carrier: plugs onto pins 1-20 of the Waveshare ESP32-P4-WIFI6-Touch-LCD-5 header."
		(exclude_from_sim no)
		(at 25.4 177.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e2348bd8-29e8-5b1c-aa3e-fad87a6f32e9")
	)
	(text "J1 is a male header fitted on the underside; pin 1 is at the end nearest the board's corner hole, 5V row nearest the edge."
		(exclude_from_sim no)
		(at 25.4 181.61 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2c104cb6-1f15-5ce8-9b9a-dd6b8a72c23e")
	)
	(text "GPIO map: ENC_A GPIO5, ENC_B GPIO4, ENC_SW GPIO2, I2C_SDA GPIO21, I2C_SCL GPIO22, ring GPIO28, strip GPIO29."
		(exclude_from_sim no)
		(at 25.4 185.42 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "8ebbf06f-10de-52cc-8496-1499105a709a")
	)
	(text "JP1/JP2 default 1-2: LED data through the 74AHCT1G125 at 5V. Cut 1-2 and bridge 2-3 to drive the LEDs directly from the GPIO."
		(exclude_from_sim no)
		(at 25.4 189.23 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "153a95cf-02d0-5577-8c50-2ce45fe042f5")
	)
	(text "R1/R2 hold the data lines low while the P4 boots. I2C pull-ups are on the GY-302 module."
		(exclude_from_sim no)
		(at 25.4 193.04 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "47709ff3-3cb9-53dc-9c49-46d7934431c6")
	)
	(text "F1 protects the header 5V from a shorted LED cable. Firmware caps LED brightness at 30% (about 0.36A for 20 LEDs)."
		(exclude_from_sim no)
		(at 25.4 196.85 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "75e17a8e-b5bf-53f3-b940-55de31055429")
	)
