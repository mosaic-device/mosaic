{
  "name": "mosaic",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.11.0 <25",
    "pnpm": ">=12.8.1 <13"
  },
  "scripts": {
    "admin:dev": "pnpm --filter @mosaic/admin dev",
    "surface:dev": "pnpm --filter @mosaic/surface dev",
    "companion:dev": "pnpm --filter @mosaic/companion tauri dev",
    "web:format": "prettier --write .",
    "web:format:check": "prettier --check .",
    "web:check": "turbo run lint typecheck build",
    "server:dev": "dotnet run --project platform/apps/server/Mosaic.Server.csproj --",
    "server:format": "dotnet format platform/Mosaic.slnx",
    "server:format:check": "dotnet format platform/Mosaic.slnx --verify-no-changes",
    "server:build": "dotnet build platform/Mosaic.slnx",
    "server:test": "dotnet test platform/Mosaic.slnx",
    "fw:format": "node scripts/format-firmware.mjs --write",
    "fw:format:check": "node scripts/format-firmware.mjs --check",
    "fw:build": "python3 scripts/firmware.py build",
    "fw:test": "python3 scripts/firmware_host_tests.py",
    "fw:preview": "python3 firmware/preview/run.py",
    "fw:flash": "python3 scripts/firmware.py flash",
    "fw:monitor": "python3 scripts/firmware.py monitor",
    "companion:format": "cargo fmt --manifest-path platform/apps/companion/src-tauri/Cargo.toml",
    "companion:check": "cargo fmt --check --manifest-path platform/apps/companion/src-tauri/Cargo.toml && cargo clippy --manifest-path platform/apps/companion/src-tauri/Cargo.toml -- -D warnings",
    "generate-tokens": "pnpm --filter @mosaic/tokens build",
    "design:check": "pnpm --filter @mosaic/assets test && pnpm --filter @mosaic/tokens test && pnpm --filter @mosaic/admin test",
    "generate-protos": "pnpm --filter @mosaic/protocols generate",
    "build:admin-assets": "pnpm --filter @mosaic/admin build && node scripts/copy-admin-assets.mjs",
    "generate-assets": "pnpm --filter @mosaic/assets generate"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "turbo": "^2.5.0"
  }
}
