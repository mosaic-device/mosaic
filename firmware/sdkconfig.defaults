# ESP-IDF 5.5.4; Waveshare ESP32-P4-WIFI6-Touch-LCD-5 (32 MB flash).
CONFIG_IDF_TARGET="esp32p4"
# The tested board is P4 rev v1.x; pre-v3 and v3+ firmware are incompatible.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_1=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# The BSP's 90-degree MIPI display uses three full RGB565 frame buffers in PSRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_BSP_LCD_DPI_BUFFER_NUMS=3
# The first synchronous LVGL refresh runs on app_main's stack.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_FREERTOS_HZ=1000
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
# Render the temporary SoftAP credentials as a scannable Wi-Fi join code.
CONFIG_LV_USE_QRCODE=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_40=y
# Keep C++ exception handling and RTTI at their IDF defaults (disabled).
