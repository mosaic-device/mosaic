{
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": "Manrope, ui-sans-serif, system-ui, sans-serif"
      },
      "display": {
        "$type": "fontFamily",
        "$value": "Fraunces, ui-serif, Georgia, serif"
      },
      "mono": {
        "$type": "fontFamily",
        "$value": "ui-monospace, SFMono-Regular, Menlo, monospace"
      }
    },
    "weight": {
      "normal": { "$type": "fontWeight", "$value": "400" },
      "medium": { "$type": "fontWeight", "$value": "500" },
      "semibold": { "$type": "fontWeight", "$value": "600" },
      "bold": { "$type": "fontWeight", "$value": "700" }
    }
  },
  "text": {
    "xs": { "$type": "dimension", "$value": "12px" },
    "sm": { "$type": "dimension", "$value": "14px" },
    "md": { "$type": "dimension", "$value": "16px" },
    "lg": { "$type": "dimension", "$value": "20px" },
    "xl": { "$type": "dimension", "$value": "24px" }
  },
  "lineHeight": {
    "tight": { "$type": "number", "$value": 1.2 },
    "normal": { "$type": "number", "$value": 1.5 }
  },
  "space": {
    "0": { "$type": "dimension", "$value": "0px" },
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "4px" },
    "md": { "$type": "dimension", "$value": "8px" },
    "lg": { "$type": "dimension", "$value": "16px" },
    "full": { "$type": "dimension", "$value": "9999px" }
  },
  "border": {
    "width": {
      "none": { "$type": "dimension", "$value": "0px" },
      "default": { "$type": "dimension", "$value": "1px" }
    }
  },
  "shadow": {
    "sm": { "$type": "shadow", "$value": "0px 1px 2px 0px rgb(0 0 0 / 0.1)" },
    "md": { "$type": "shadow", "$value": "0px 4px 6px 0px rgb(0 0 0 / 0.1)" },
    "lg": { "$type": "shadow", "$value": "0px 10px 15px 0px rgb(0 0 0 / 0.1)" }
  }
}
