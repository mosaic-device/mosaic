      "$type": "color",
      "$value": "rgba(255, 255, 255, 0.96)"
    },
    "surfaceSunken": {
      "$type": "color",
      "$value": "rgba(228, 228, 231, 0.72)"
    },
    "primary": { "$type": "color", "$value": "{primitive.color.blue.600}" },
