      "$value": "{primitive.color.neutral.950}"
    },
    "surface": { "$type": "color", "$value": "rgba(255, 255, 255, 0.94)" },
    "surfaceForeground": {
      "$type": "color",
      "$value": "{primitive.color.neutral.950}"
    },
    "surfaceMuted": { "$type": "color", "$value": "rgba(244, 244, 245, 0.88)" },
