{
  "name": "@mosaic/assets",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./fonts.css": "./web/fonts.css",
    "./web/*": "./web/*",
    "./models/*": "./models/*"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "node --test tests/*.test.mjs",
    "generate": "python3 scripts/fonts.py && node scripts/generate.mjs && node scripts/cues.mjs",
    "generate:cues": "node scripts/cues.mjs",
    "generate:model": "node scripts/device-model.mjs"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "fontkit": "2.0.4",
    "lv_font_conv": "1.5.3",
    "meshoptimizer": "1.3.0",
    "occt-import-js": "0.0.23",
    "sharp": "0.35.5"
  }
}
