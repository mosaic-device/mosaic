---
import Home from '../layouts/Home.astro'
import Hero from '../components/home/Hero.astro'
import Waits from '../components/home/Waits.astro'
import Calm from '../components/home/Calm.astro'
import WorksWith from '../components/home/WorksWith.astro'
import Journey from '../components/home/Journey.astro'
import OpenSource from '../components/home/OpenSource.astro'
import Footer from '../components/home/Footer.astro'
---

<Home
  title="Mosaic: what needs you, in one view"
  description="Mosaic puts GitHub, Slack, Jira, Discord and your calendar on a small display beside your laptop. Open source, self-hosted and built by you."
>
  <Hero />
  <main>
    <Waits />
    <Calm />
    <div class="pause" aria-hidden="true"></div>
    <WorksWith />
    <div class="pause" aria-hidden="true"></div>
    <Journey />
    <OpenSource />
  </main>
  <Footer />
</Home>
