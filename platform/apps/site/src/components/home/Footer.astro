---
// The page ends on one quiet row: the wordmark, and where to go for more.
import { links } from './links'
---

<footer class="footer">
  <div class="row">
    <a class="wordmark" href="/">MOSAIC</a>
    <nav class="links" aria-label="Footer">
      <a href={links.docs}>Docs</a>
      <a href={links.github}>GitHub</a>
    </nav>
  </div>
</footer>

<style>
  /* On the page's 160 px margins, scaled with it, never under 24 px. */
  .footer {
    width: min(100%, 1440px);
    margin: 0 auto;
    padding: 0 max(24px, min(160px, 11.111vw));
    box-sizing: border-box;
  }
  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 104px;
    border-top: 1px solid var(--hairline);
  }
  .wordmark {
    font-family: var(--font-family-brand);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.34em;
    color: var(--color-muted-foreground);
  }
  .links {
    display: flex;
    gap: 32px;
    font-size: 14px;
  }
  .links a,
  .wordmark {
    transition: color 150ms ease;
  }
  .links a {
    color: var(--color-muted-foreground);
  }
  .links a:hover,
  .wordmark:hover {
    color: var(--color-foreground);
  }
</style>
