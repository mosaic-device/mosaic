---
// Hero: the device leads, high and centred on a desk, the warm light of its
// LED strip pooling under it, its ring blue because something is waiting.
// The copy runs along the foot like a caption: the headline and line from the
// 160 line, the button on the block's right edge, level with the line's end.
import hero from '@mosaic/assets/renders/hero.avif'
import { links } from './links'
---

<section class="stage hero" aria-labelledby="hero-title">
  <nav class="nav" aria-label="Main">
    <a class="wordmark" href="/">MOSAIC</a>
    <div class="links">
      <a href={links.docs}>Docs</a>
      <a class="github" href={links.github}>
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"
          ><path
            d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
          ></path></svg
        >
        GitHub
      </a>
    </div>
  </nav>

  <div class="scene at" style="--x: 400; --y: 137; --w: 640">
    <img
      class="render"
      src={hero.src}
      width={hero.width}
      height={hero.height}
      alt="Mosaic display on a desk showing Firmware standup in 4 minutes, its knob ring lit blue because a notification is waiting, warm light from its LED strip pooling beneath it"
      fetchpriority="high"
    />
  </div>

  <div class="copy">
    <h1 id="hero-title" class="display" style="--size: 60">
      What needs you, <br class="break" />in one view.
    </h1>
    <div class="row">
      <p class="lede">
        Mosaic puts GitHub, Slack, Jira, Discord and your calendar on a small
        display beside your laptop.
        Open source, <span class="nowrap">self-hosted</span> and built by you.
      </p>
      <a class="button primary" href={links.build}>Build your own</a>
    </div>
  </div>
</section>

<style>
  .hero {
    overflow: clip;
  }
  .nav {
    position: absolute;
    inset: 0 0 auto;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 88px;
    padding: 0 max(24px, calc(160 * var(--u)));
  }
  .wordmark {
    font-family: var(--font-family-brand);
    font-size: 20px;
    font-weight: 500;
    letter-spacing: 0.34em;
  }
  .links {
    display: flex;
    align-items: center;
    gap: 40px;
    font-size: 14px;
  }
  .links a {
    color: var(--color-muted-foreground);
  }
  .links a:hover {
    color: var(--color-foreground);
  }
  .links .github {
    display: flex;
    align-items: center;
    gap: 8px;
    box-sizing: border-box;
    height: 40px;
    padding: 0 16px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-foreground);
    font-weight: 500;
  }

  .copy {
    z-index: 3;
  }
  .nowrap {
    white-space: nowrap;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 28px 40px;
    margin-top: 20px;
  }
  .lede {
    max-width: 560px;
  }
  .row .button {
    flex: none;
  }

  /*
   * The slot is the device's box, centred (400–1040), its case from y 180. The
   * render is wider, with the desk fading out around the device (it fills 44%
   * of the render's width), so it overflows the slot, centred on it.
   */
  .scene {
    z-index: 2;
    aspect-ratio: 724 / 358;
    pointer-events: none;
  }
  .render {
    position: absolute;
    left: 50%;
    top: 50%;
    width: calc(100% / 0.44);
    max-width: none;
    height: auto;
    transform: translate(-50%, -50%);
    /* The desk renders as the page's own colour, so fading the render in and
       out only touches what's on it. At the top, its far edge (a shade off
       the page, and banded) is faded out, whole by the case's top (34%). At
       the foot, the tail of the strip's light ends (87%) well above the
       copy rather than running under it. */
    mask-image: linear-gradient(
      transparent 22%,
      #000 32%,
      #000 76%,
      transparent 87%
    );
  }

  @media (min-width: 900px) {
    .nav {
      position: absolute;
    }
    /*
     * The canon's 900-high frame, but never taller than the window, so the
     * copy along the foot is in the first screen on any window 720 or more
     * tall; and never shorter than 800, below which the headline would meet
     * the device's light.
     */
    .hero {
      aspect-ratio: auto;
      height: clamp(
        calc(min(100vw, 1440px) * 800 / 1440),
        100svh,
        calc(min(100vw, 1440px) * 900 / 1440)
      );
    }
    /* One line across the block; below 900px it breaks after the comma. */
    h1 {
      white-space: nowrap;
    }
    .break {
      display: none;
    }
    .copy {
      position: absolute;
      left: calc(160 * var(--u));
      right: calc(160 * var(--u));
      bottom: calc(80 * var(--u));
    }
  }

  @media (max-width: 899.98px) {
    .hero {
      padding-top: 0;
      display: flex;
      flex-direction: column;
    }
    .nav {
      position: relative;
      padding: 0;
      height: 72px;
      margin-bottom: 48px;
    }
    .links {
      gap: 20px;
    }
    /* The device first, then the copy under it; room below the device for
       its light to fade out. */
    .scene {
      position: relative;
      margin: 24px 0 20%;
    }
  }
</style>
