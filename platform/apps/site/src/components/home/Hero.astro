---
// Hero, direction 3c: the device on a desk, warm light pooling under it, its
// ring blue because something is waiting.
import hero from '@mosaic/assets/renders/hero.avif'
import { links } from './links'
---

<section class="stage hero" aria-labelledby="hero-title">
  <div class="pool" aria-hidden="true"></div>

  <nav class="nav" aria-label="Main">
    <a class="wordmark" href="/">MOSAIC</a>
    <div class="links">
      <a class="desktop-only" href="#features">Features</a>
      <a class="desktop-only" href="#integrations">Integrations</a>
      <a class="desktop-only" href="#hardware">Hardware</a>
      <a href={links.docs}>Docs</a>
      <a class="github" href={links.github}>GitHub</a>
    </div>
  </nav>

  <div class="copy at" style="--x: 160; --y: 300; --w: 420">
    <h1 id="hero-title" class="display" style="--size: 60">
      Everything that<br />needs you,<br />in one view.
    </h1>
    <p class="lede">
      A 5-inch desk display for GitHub, Slack, Jira, Discord and your calendar.
      Glance, dismiss or act without leaving your editor.
    </p>
    <div class="actions">
      <a class="button primary" href={links.build}>Build your own</a>
      <a class="button" href={links.github}>View on GitHub</a>
    </div>
  </div>

  <div class="scene at" style="--x: 640; --y: 334; --w: 640">
    <img
      class="render"
      src={hero.src}
      width={hero.width}
      height={hero.height}
      alt="Mosaic display on a desk showing Firmware standup in 4 minutes, its knob ring lit blue because a notification is waiting"
      fetchpriority="high"
    />
  </div>
</section>

<style>
  .hero {
    overflow: clip;
  }
  .nav {
    position: absolute;
    inset: 0 0 auto;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 88px;
    padding: 0 max(24px, calc(160 * var(--u)));
  }
  .wordmark {
    font-family: var(--font-family-brand);
    font-size: 20px;
    font-weight: 500;
    letter-spacing: 0.34em;
  }
  .links {
    display: flex;
    align-items: center;
    gap: 40px;
    font-size: 14px;
  }
  .links a {
    color: var(--color-muted-foreground);
  }
  .links a:hover {
    color: var(--color-foreground);
  }
  .links .github {
    display: flex;
    align-items: center;
    box-sizing: border-box;
    height: 40px;
    padding: 0 16px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-foreground);
    font-weight: 500;
  }

  .copy {
    z-index: 3;
  }
  .lede {
    max-width: 420px;
    margin-top: 24px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  .pool {
    position: absolute;
    left: calc(640 * var(--u));
    top: calc(580 * var(--u));
    width: calc(640 * var(--u));
    height: calc(200 * var(--u));
    border-radius: 50%;
    background: rgb(var(--warm) / 0.16);
    filter: blur(calc(60 * var(--u)));
  }

  /*
   * The slot is the device's box, on the content block's right half. The
   * render is wider, with the desk fading out around the device (it fills 44%
   * of the render's width), so it overflows the slot, centred on it.
   */
  .scene {
    z-index: 2;
    aspect-ratio: 724 / 358;
    pointer-events: none;
  }
  .render {
    position: absolute;
    left: 50%;
    top: 50%;
    width: calc(100% / 0.44);
    max-width: none;
    height: auto;
    transform: translate(-50%, -50%);
  }

  @media (min-width: 900px) {
    .nav {
      position: absolute;
    }
  }

  @media (max-width: 899.98px) {
    .hero {
      padding-top: 0;
      display: flex;
      flex-direction: column;
    }
    .nav {
      position: relative;
      padding: 0;
      height: 72px;
      margin-bottom: 48px;
    }
    .links {
      gap: 20px;
    }
    /* Room below for the render's desk to fade out, which brings its own
       warm light, so the pool isn't needed here. */
    .scene {
      position: relative;
      margin: 64px 0 30%;
    }
    .pool {
      display: none;
    }
  }
</style>
