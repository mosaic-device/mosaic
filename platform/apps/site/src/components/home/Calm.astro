---
// S3: the calm state, up close. A framed, square-on view of the knob and the
// case's lower edge: screen off, the ring a soft warm white, and the warm
// light of the LED strip on the underside pooling on the desk beneath.
import calm from '@mosaic/assets/renders/calm.avif'
---

<section class="stage calm" style="--h: 1080" aria-labelledby="calm-title">
  <div class="copy">
    <h2 id="calm-title" class="display" style="--size: 48">
      Calm, until it matters.
    </h2>
    <p class="lede">
      With nothing new, it keeps to a warm glow on the desk beneath it.
    </p>
  </div>

  <div
    class="frame at"
    style="--x: 160; --y: 240; --w: 1120"
  >
    <img
      src={calm.src}
      width={calm.width}
      height={calm.height}
      loading="lazy"
      alt="Close-up of Mosaic's knob in its case, the screen off and the LED ring a soft warm white, warm light glowing from beneath the device onto the desk"
    />
  </div>

  <ul class="promises list" aria-label="How Mosaic stays calm">
    <li><strong class="list-name">Nothing blinks or spins.</strong> <span class="list-note">Every change fades.</span></li>
    <li><strong class="list-name">Quiet hours.</strong> <span class="list-note">Only what's urgent gets through.</span></li>
    <li><strong class="list-name">Dims with the room.</strong> <span class="list-note">A light sensor sets the brightness.</span></li>
    <li><strong class="list-name">Amber means trouble.</strong> <span class="list-note">Like losing your server.</span></li>
  </ul>
</section>

<style>
  .copy {
    text-align: center;
  }
  .lede {
    max-width: 560px;
    margin: 16px auto 0;
  }

  /* A crisp window onto the device; the scene crops to the same rectangle. */
  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    box-sizing: border-box;
    border: 1px solid var(--color-surface-raised);
    border-radius: var(--radius-lg);
    background: #0b0c0c;
  }
  .frame img {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }


  @media (min-width: 900px) {
    .copy {
      position: absolute;
      left: 0;
      right: 0;
      top: calc(100 * var(--u));
    }
    .promises {
      position: absolute;
      left: calc(160 * var(--u));
      right: calc(160 * var(--u));
      top: calc(950 * var(--u));
      grid-template-columns: repeat(4, 1fr);
    }
    /* Four equal columns across the block, each starting on its quarter. */
    .promises li {
      padding-right: calc(40 * var(--u));
    }
  }

  @media (max-width: 899.98px) {
    .frame {
      margin-top: 40px;
    }
    .promises {
      margin-top: 40px;
    }
  }
  @media (min-width: 600px) and (max-width: 899.98px) {
    .promises {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px 32px;
    }
  }
</style>
