---
// S3: the calm state, up close. A framed macro of the device's knob corner:
// screen off, ring dark, only the warm light from the strip behind it. The 3D
// scene renders the device cropped to the frame.
---

<section class="stage calm" aria-labelledby="calm-title">
  <div class="copy">
    <h2 id="calm-title" class="display" style="--size: 48">
      Calm, until it matters.
    </h2>
    <p class="lede">
      When nothing needs you, all you see is a warm glow behind the device.
    </p>
  </div>

  <div
    class="frame at"
    style="--x: 240; --y: 260; --w: 960"
    data-slot="macro"
    role="img"
    aria-label="Close-up of Mosaic's knob in its case, the screen off and the LED ring dark, warm light glowing from behind the device"
  >
    <div class="warmth" aria-hidden="true"></div>
  </div>

  <ul class="promises" aria-label="What Mosaic doesn't do">
    <li><strong>Nothing blinks or spins.</strong> Every change fades.</li>
    <li><strong>Quiet hours.</strong> What can wait, waits.</li>
    <li><strong>Dims with the room.</strong> A light sensor follows it.</li>
    <li><strong>Amber only when wrong.</strong> Your server is out of reach.</li>
  </ul>
</section>

<style>
  .copy {
    text-align: center;
  }
  .lede {
    max-width: 560px;
    margin: 16px auto 0;
  }

  /* A crisp window onto the device; the scene crops to the same rectangle. */
  .frame {
    position: relative;
    aspect-ratio: 960 / 440;
    overflow: hidden;
    box-sizing: border-box;
    border: 1px solid var(--color-surface-raised);
    border-radius: var(--radius-lg);
    background: #0b0c0c;
  }
  /* The LED strip's light on the surface behind the device. */
  .warmth {
    position: absolute;
    right: -8%;
    top: 4%;
    width: 62%;
    height: 92%;
    border-radius: 50%;
    background: rgb(var(--warm) / 0.22);
    filter: blur(70px);
  }

  .promises {
    padding: 22px 0 0;
    list-style: none;
    border-top: 1px solid var(--hairline);
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-muted-foreground);
  }
  .promises strong {
    color: var(--color-foreground);
    font-weight: 500;
  }

  @media (min-width: 900px) {
    .copy {
      position: absolute;
      left: 0;
      right: 0;
      top: calc(100 * var(--u));
    }
    .promises {
      position: absolute;
      left: calc(160 * var(--u));
      right: calc(160 * var(--u));
      top: calc(780 * var(--u));
      display: flex;
      justify-content: space-between;
      gap: 32px;
    }
  }

  @media (max-width: 899.98px) {
    .frame {
      margin-top: 40px;
    }
    .promises {
      display: grid;
      gap: 14px;
      margin-top: 40px;
    }
  }
</style>
