---
// S2: one notification, annotated. As the device comes into view the
// notification arrives once: the ring turns blue, then the review request
// replaces the calendar (three renders crossfaded).
import dark from '@mosaic/assets/renders/waits-dark.avif'
import ring from '@mosaic/assets/renders/waits-ring.avif'
import review from '@mosaic/assets/renders/waits-review.avif'
---

<section id="features" class="waits" data-step="all" aria-labelledby="waits-title">
  <div class="pin">
    <div class="stage">
      <h2 id="waits-title" class="display at" style="--x: 160; --y: 96; --w: 700">
        <span class="quiet">Your laptop interrupts.</span><br />Mosaic waits.
      </h2>

      <div class="glow desktop-only" aria-hidden="true"></div>
      <div class="scene at" style="--x: 400; --y: 290; --w: 859">
        <img class="render" src={dark.src} loading="lazy" width={dark.width} height={dark.height} alt="" />
        <img class="render ring" src={ring.src} width={ring.width} height={ring.height} alt="" />
        <img
          class="render review"
          src={review.src}
          width={review.width}
          height={review.height}
          alt="Mosaic display showing a GitHub review request: Avery requested your review on #194. Its knob ring is lit blue."
        />
      </div>

      <ol class="callouts">
        <li class="callout at" data-for="1" style="--x: 1080; --y: 132; --w: 280">
          <h3>It arrives</h3>
          <p>
            The ring turns blue and the glow behind the device swells once.
            Nothing pops up on your laptop.
          </p>
        </li>
        <li class="callout at" data-for="2" style="--x: 160; --y: 388; --w: 210">
          <h3>You glance</h3>
          <p>From your chair: Avery wants your review on #194, two minutes ago.</p>
        </li>
        <li class="callout at" data-for="3" style="--x: 160; --y: 596; --w: 210">
          <h3>You decide</h3>
          <p>Approve it here, press the knob to dismiss, or send it to your laptop.</p>
        </li>
      </ol>

      <!-- Leaders from each callout to the part it describes. -->
      <div class="leader desktop-only" data-for="1" aria-hidden="true">
        <i class="line" style="--x: 1188; --y: 262; --w: 1; --h: 196"></i>
        <i class="dot" style="--x: 1184; --y: 456"></i>
      </div>
      <div class="leader desktop-only" data-for="2" aria-hidden="true">
        <i class="line" style="--x: 380; --y: 440; --w: 64; --h: 1"></i>
        <i class="dot" style="--x: 442; --y: 436"></i>
      </div>
      <div class="leader desktop-only" data-for="3" aria-hidden="true">
        <i class="line" style="--x: 380; --y: 649; --w: 56; --h: 1"></i>
        <i class="dot" style="--x: 434; --y: 645"></i>
      </div>
    </div>
  </div>
</section>

<script>
  // The notification arrives once, when the device is well in view.
  const section = document.querySelector<HTMLElement>('.waits')
  const scene = section?.querySelector('.scene')
  if (section && scene) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry?.isIntersecting) return
        observer.disconnect()
        section.setAttribute('data-arrived', '')
      },
      { threshold: 0.4 },
    )
    observer.observe(scene)
  }
</script>

<style>
  /* The renders have room above and below the device; centre them. */
  .scene {
    aspect-ratio: 859 / 425;
  }
  .render {
    position: absolute;
    left: 0;
    top: 50%;
    width: 100%;
    height: auto;
    transform: translateY(-50%);
  }
  .ring,
  .review {
    opacity: 0;
  }
  .waits[data-arrived] .ring {
    opacity: 1;
    transition: opacity 600ms cubic-bezier(0.23, 1, 0.32, 1) 150ms;
  }
  .waits[data-arrived] .review {
    opacity: 1;
    transition: opacity 400ms cubic-bezier(0.23, 1, 0.32, 1) 650ms;
  }
  @media (prefers-reduced-motion: reduce), (max-width: 899.98px) {
    .ring,
    .review {
      opacity: 1;
      transition: none;
    }
  }

  .quiet {
    color: var(--color-low-emphasis);
  }

  .glow {
    position: absolute;
    left: calc(470 * var(--u));
    top: calc(660 * var(--u));
    width: calc(720 * var(--u));
    height: calc(120 * var(--u));
    border-radius: 50%;
    background: rgb(var(--ring-blue) / 0.16);
    filter: blur(calc(60 * var(--u)));
    opacity: 0;
    transition: opacity 600ms cubic-bezier(0.23, 1, 0.32, 1) 150ms;
  }
  /* The scene sets data-arrived when the notification arrives. Played once. */
  .waits[data-arrived] .glow {
    opacity: 1;
    animation: swell 1200ms cubic-bezier(0.23, 1, 0.32, 1) 150ms;
  }
  @keyframes swell {
    40% {
      background: rgb(var(--ring-blue) / 0.3);
      transform: scale(1.08);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .waits .glow {
      opacity: 1;
      transition: none;
      animation: none;
    }
  }

  .scene :global(.body) {
    box-shadow:
      0 40px 80px rgb(0 0 0 / 0.6),
      inset 0 1px 0 rgb(255 255 255 / 0.07);
  }

  .callouts {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .callout h3 {
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-muted-foreground);
    transition: color 400ms ease;
  }
  .callout p {
    margin-top: 8px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-muted-foreground);
  }

  .leader i {
    position: absolute;
    left: calc(var(--x) * var(--u));
    top: calc(var(--y) * var(--u));
    transition: background-color 400ms ease;
  }
  .leader .line {
    width: max(1px, calc(var(--w) * var(--u)));
    height: max(1px, calc(var(--h) * var(--u)));
    background: var(--color-border);
  }
  .leader .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #3a3d40;
  }

  /* The lit callout and its leader. */
  .waits[data-step='1'] [data-for='1'] h3,
  .waits[data-step='2'] [data-for='2'] h3,
  .waits[data-step='3'] [data-for='3'] h3,
  .waits[data-step='all'] .callout h3 {
    color: var(--color-foreground);
  }
  .waits[data-step='1'] .leader[data-for='1'] .line,
  .waits[data-step='2'] .leader[data-for='2'] .line,
  .waits[data-step='3'] .leader[data-for='3'] .line,
  .waits[data-step='all'] .leader .line {
    background: var(--color-muted-foreground);
  }
  .waits[data-step='1'] .leader[data-for='1'] .dot,
  .waits[data-step='2'] .leader[data-for='2'] .dot,
  .waits[data-step='3'] .leader[data-for='3'] .dot,
  .waits[data-step='all'] .leader .dot {
    background: var(--color-foreground);
  }

  @media (max-width: 899.98px) {
    .scene {
      margin-top: 40px;
    }
    .callouts {
      display: grid;
      gap: 28px;
      margin-top: 48px;
    }
  }
</style>
