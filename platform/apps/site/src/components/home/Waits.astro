---
// S2: one notification, annotated. A still of the moment it arrives: the
// review request on screen, the ring blue, the strip beneath swelling blue.
import waits from '@mosaic/assets/renders/waits.avif'
---

<section id="features" class="waits" aria-labelledby="waits-title">
  <div class="stage">
      <h2 id="waits-title" class="display at" style="--x: 160; --y: 96; --w: 700">
        <span class="quiet">Your laptop interrupts.</span><br />Mosaic waits.
      </h2>

      <div class="glow desktop-only" aria-hidden="true"></div>
      <div class="scene at" style="--x: 400; --y: 290; --w: 859">
        <img
          class="render"
          src={waits.src}
          width={waits.width}
          height={waits.height}
          loading="lazy"
          alt="Mosaic display showing a GitHub review request: Avery requested your review on #194. Its knob ring is lit blue."
        />
      </div>

      <ol class="callouts">
        <li class="callout at" style="--x: 1080; --y: 132; --w: 280">
          <h3>It arrives</h3>
          <p>
            The ring turns blue and the glow beneath the device swells once.
            Nothing pops up on your laptop.
          </p>
        </li>
        <li class="callout at" style="--x: 160; --y: 400; --w: 210">
          <h3>You glance</h3>
          <p>From your chair: Avery wants your review on #194, two minutes ago.</p>
        </li>
        <li class="callout at" style="--x: 160; --y: 562; --w: 210">
          <h3>You decide</h3>
          <p>Approve it here, press the knob to dismiss, or send it to your laptop.</p>
        </li>
      </ol>

      <!-- Leaders from each callout to the part it describes. -->
      <div class="leader desktop-only" aria-hidden="true">
        <i class="line" style="--x: 1136; --y: 262; --w: 1; --h: 189"></i>
        <i class="dot" style="--x: 1132; --y: 449"></i>
      </div>
      <div class="leader desktop-only" aria-hidden="true">
        <i class="line" style="--x: 380; --y: 452; --w: 120; --h: 1"></i>
        <i class="dot" style="--x: 498; --y: 448"></i>
      </div>
      <div class="leader desktop-only" aria-hidden="true">
        <i class="line" style="--x: 380; --y: 615; --w: 120; --h: 1"></i>
        <i class="dot" style="--x: 498; --y: 611"></i>
      </div>
  </div>
</section>

<style>
  /* The renders have room above and below the device; centre them. */
  .scene {
    aspect-ratio: 859 / 425;
  }
  .render {
    position: absolute;
    left: 0;
    top: 50%;
    width: 100%;
    height: auto;
    transform: translateY(-50%);
  }
  .quiet {
    color: var(--color-low-emphasis);
  }

  /* The LED strip's light beneath the device, at its blue swell. */
  .glow {
    position: absolute;
    left: calc(470 * var(--u));
    top: calc(660 * var(--u));
    width: calc(720 * var(--u));
    height: calc(120 * var(--u));
    border-radius: 50%;
    background: rgb(var(--ring-blue) / 0.16);
    filter: blur(calc(60 * var(--u)));
  }

  .callouts {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .callout h3 {
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-foreground);
  }
  .callout p {
    margin-top: 8px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-muted-foreground);
  }

  .leader i {
    position: absolute;
    left: calc(var(--x) * var(--u));
    top: calc(var(--y) * var(--u));
  }
  .leader .line {
    width: max(1px, calc(var(--w) * var(--u)));
    height: max(1px, calc(var(--h) * var(--u)));
    background: var(--color-muted-foreground);
  }
  .leader .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-foreground);
  }

  @media (max-width: 899.98px) {
    .scene {
      margin-top: 40px;
    }
    .callouts {
      display: grid;
      gap: 28px;
      margin-top: 48px;
    }
  }
</style>
