---
// S6: built from open parts. The device, carried over from S5, lies down and
// comes apart into its layers as you scroll; labels follow each part. The scene
// is 3D (scripts/device). Phones list the parts under it.
import { links } from './links'

const labels = [
  { part: 'dial', name: 'Push knob', note: 'With an LED ring' },
  { part: 'acrylic', name: 'Acrylic front', note: 'Over the screen' },
  { part: 'display-board', name: '5" touch display', note: 'ESP32-P4, Wi-Fi 6' },
  { part: 'carrier-pcb', name: 'Carrier PCB', note: 'Open KiCad files' },
  { part: 'case-outer', name: 'Case', note: '3D-printed' },
]
---

<section id="hardware" class="layers" aria-labelledby="layers-title">
  <div class="pin">
    <div class="stage">
      <div class="copy">
        <h2 id="layers-title" class="display">
          Built by you,<br />from open parts.
        </h2>
        <p class="lede">
          An off-the-shelf display board, a small carrier PCB, a few modules and
          a 3D-printed case. Every file is open.
        </p>
        <a class="button primary" href={links.build}>Read the build guide</a>
      </div>

      <div
        class="slot at"
        style="--x: 500; --y: 50; --w: 640"
        data-slot="layers"
        role="img"
        aria-label="Mosaic pulled apart into its layers: push knob, acrylic front, 5-inch touch display, carrier PCB and 3D-printed case"
      >
      </div>

      {
        labels.map((l) => (
          <div
            class="anchored column"
            style="--col: 1190"
            data-anchor={l.part}
            data-section="layers"
            aria-hidden="true"
          >
            <span class="name">{l.name}</span>
            <span class="note">{l.note}</span>
          </div>
        ))
      }

      <ul class="parts" aria-label="Parts">
        {
          labels.map((l) => (
            <li>
              <span class="name">{l.name}</span>{' '}
              <span class="note">{l.note}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .lede {
    margin-top: 24px;
  }
  .button {
    margin-top: 32px;
  }
  .slot {
    aspect-ratio: 640 / 800;
  }
  .parts .name {
    font-weight: 500;
  }
  .parts .note {
    color: var(--color-muted-foreground);
  }

  @media (min-width: 900px) {
    .copy {
      position: absolute;
      left: calc(160 * var(--u));
      bottom: calc(120 * var(--u));
      width: calc(360 * var(--u));
      z-index: 1;
    }
    .parts {
      display: none;
    }
  }

  @media (min-width: 900px) and (prefers-reduced-motion: no-preference) {
    .layers {
      height: 150vh;
    }
    .pin {
      position: sticky;
      top: 0;
      height: 100vh;
      display: flex;
      align-items: center;
    }
    .pin .stage {
      width: min(100%, 1440px, 160vh);
    }
  }

  @media (max-width: 899.98px) {
    .stage {
      display: flex;
      flex-direction: column;
    }
    .slot {
      order: -2;
      width: 80%;
      align-self: center;
    }
    .parts {
      display: grid;
      gap: 12px;
      margin: 24px 0 48px;
      padding: 0;
      list-style: none;
      order: -1;
    }
  }
</style>
