        ></path></symbol
      >
    </defs>
  </svg>

  <div class="wall desktop-only" aria-hidden="true">
    {
      tiles.map((t) => (
        <span class="tile" style={`--x: ${t.x}; --y: ${t.y}`}>
          <svg style={`fill-opacity: ${t.shade}`}>
            <use href={`#logo-${t.mark}`} />
          </svg>
        </span>
      ))
    }
  </div>
  <div class="centre desktop-only" aria-hidden="true"></div>

  <div class="copy">
    <h2 id="works-title" class="display" style="--size: 40">
      Many pieces. One view.
    </h2>
    <p class="lede">
      Review requests and failed builds, DMs and mentions, assigned issues and
      your next meeting.
    </p>
    <ul class="marks" aria-label="Integrations">
      {
        services.map((s) => (
          <li>
            <svg aria-hidden="true">
              <use href={`#logo-${s.id}`} />
            </svg>
            <span class="visually-hidden">{s.name}</span>
          </li>
        ))
      }
    </ul>
    <a class="arrow-link" href={links.docs}>
      All integrations
      <svg
        aria-hidden="true"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg
      >
    </a>
  </div>
</section>

<style>
  .works {
    overflow: clip;
  }
  .wall {
    position: absolute;
    inset: 0;
    mask-image: linear-gradient(
      180deg,
      transparent 0%,
      #000 30%,
      #000 70%,
      transparent 100%
    );
  }
  .tile {
    position: absolute;
    left: calc(var(--x) * var(--u));
    top: calc(var(--y) * var(--u));
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: calc(70 * var(--u));
    height: calc(70 * var(--u));
    border: 1px solid #161718;
    border-radius: calc(14 * var(--u));
    background: #0d0e0e;
  }
  .tile svg {
    width: calc(26 * var(--u));
    height: calc(26 * var(--u));
    fill: var(--color-foreground);
  }
  .centre {
    position: absolute;
    left: calc(325 * var(--u));
    top: calc(205 * var(--u));
    width: calc(790 * var(--u));
    height: calc(310 * var(--u));
    box-sizing: border-box;
    border: 1px solid var(--color-surface-raised);
    border-radius: calc(20 * var(--u));
    background: #121314;
  }

  .copy {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .lede {
    max-width: 560px;
    margin-top: 20px;
  }
  .arrow-link {
    margin-top: 32px;
    color: var(--color-muted-foreground);
  }
  .arrow-link:hover {
    color: var(--color-foreground);
  }

  /* The services as a plain row, for phones; on desktop the wall shows them. */
  .marks {
    display: flex;
    gap: 12px;
    margin-top: 32px;
    padding: 0;
    list-style: none;
  }
  .marks li {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    box-sizing: border-box;
    border: 1px solid #161718;
    border-radius: 12px;
    background: #0d0e0e;
  }
  .marks svg {
    width: 22px;
    height: 22px;
    fill: var(--color-foreground);
    fill-opacity: 0.4;
  }

  @media (min-width: 900px) {
    .copy {
      position: absolute;
      inset: 0;
      justify-content: center;
    }
    .marks {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
  }
</style>
