---
// S4: a still pause. A wall of small tiles, one service mark each, around one
// larger tile holding the headline: many pieces, one view.
import { links } from './links'

const services = [
  { id: 'github', name: 'GitHub' },
  { id: 'jira', name: 'Jira' },
  { id: 'googlecalendar', name: 'Google Calendar' },
  { id: 'slack', name: 'Slack' },
  { id: 'discord', name: 'Discord' },
] as const
const shades = [0.2, 0.3, 0.25, 0.36, 0.17]

// Tiles on the canon's 80 px half-steps, each gap centred on a line, leaving
// a hole for the headline tile: columns 320 to 1120, rows 200 to 520. Each row
// shifts the marks and shades so no two neighbours match.
const tiles = []
for (let row = 0; row < 10; row++)
  for (let col = -1; col < 18; col++) {
    const x = col * 80 + 5
    const y = row * 80 - 35
    if (row >= 3 && row <= 6 && col >= 4 && col <= 13) continue
    tiles.push({
      x,
      y,
      mark: services[(((col - row) % 5) + 10) % 5]!.id,
      shade: shades[(((col + 2 * row) % 5) + 5) % 5],
    })
  }
---

