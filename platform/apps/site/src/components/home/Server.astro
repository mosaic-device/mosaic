---
// S5: everything on the plate is yours. On desktop the section pins: the device
// lands on the plate, your server and laptop rise beside it, and a review
// request travels from your server to Mosaic, whose ring turns blue. The scene
// is 3D (scripts/device); the labels here follow it.
import { links } from './links'
---

<section class="server" aria-labelledby="server-title">
  <div class="pin">
    <div class="stage">
      <div class="copy at" style="--x: 160; --y: 100; --w: 360">
        <h2 id="server-title" class="display">Your server.<br />Your tokens.</h2>
        <p class="lede">
          Mosaic runs on a server you host, in Docker or as a single binary.
          Your tokens and your activity never pass through anyone else's
          servers.
        </p>
        <p class="lede">There's no Mosaic cloud and nothing to sign up for.</p>
        <a class="arrow-link" href={links.selfHosting}>
          Read the self-hosting guide
          <svg
            aria-hidden="true"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg
          >
        </a>
      </div>

      <div
        class="slot at"
        style="--x: 470; --y: 270; --w: 960"
        data-slot="server"
        role="img"
        aria-label="Your server, Mosaic and your laptop sit on a plate marked Yours. Your accounts float outside it. A review request travels from your server to Mosaic, whose ring turns blue. Your tokens live on your server, which also runs the admin app; the companion app runs on your laptop."
      >
      </div>

      <div
        class="anchored column"
        style="--col: 1170"
        data-anchor="server"
        data-section="server"
        aria-hidden="true"
      >
        <span class="name">Your server</span>
        <span class="note">Docker or a single binary</span>
        <span class="note accent">Your tokens live here</span>
        <span class="note">Admin app: connect accounts, pair</span>
      </div>
      <div
        class="anchored column"
        style="--col: 1170"
        data-anchor="mosaic"
        data-section="server"
        aria-hidden="true"
      >
        <span class="name">Mosaic</span>
        <span class="note">On your desk</span>
      </div>
      <div
        class="anchored at"
        style="--dy: 2.4"
        data-anchor="laptop"
        data-section="server"
        aria-hidden="true"
      >
        <span class="name">Companion app</span>
        <span class="note">On your laptop</span>
      </div>
      <div
        class="anchored at"
        style="--dy: -1.6"
        data-anchor="accounts"
        data-section="server"
        aria-hidden="true"
      >
        <span class="note">Your accounts</span>
      </div>
      <div
        class="anchored at yours"
        style="--dx: -1.8; --dy: -1"
        data-anchor="yours"
        data-section="server"
        aria-hidden="true"
      >
        Yours
      </div>
      <div class="pill" data-pill aria-hidden="true">
        <i></i>Review request
      </div>
    </div>
  </div>
</section>

<style>
  .lede {
    margin-top: 24px;
  }
  .lede + .lede {
    margin-top: 16px;
  }
  .arrow-link {
    margin-top: 32px;
  }
  .slot {
    aspect-ratio: 960 / 560;
  }
  .accent {
    color: var(--color-focus);
  }
  .yours {
    font-size: max(13px, calc(14 * var(--u)));
    font-weight: 500;
    color: var(--color-focus);
  }

  .pill {
    position: absolute;
    left: var(--ax);
    top: var(--ay);
    z-index: 11;
    display: flex;
    align-items: center;
    gap: 8px;
    height: 26px;
    padding: 0 12px 0 10px;
    border: 1px solid rgb(var(--ring-blue) / 0.6);
    border-radius: 13px;
    background: var(--color-surface);
    font-size: 12px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -50%);
  }
  .pill i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgb(var(--ring-blue));
  }

  @media (min-width: 900px) and (prefers-reduced-motion: no-preference) {
    .server {
      height: 180vh;
    }
    .pin {
      position: sticky;
      top: 0;
      height: 100vh;
      display: flex;
      align-items: center;
    }
    .pin .stage {
      width: min(100%, 1440px, 160vh);
    }
  }

  @media (max-width: 899.98px) {
    .copy {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }
    .slot {
      margin-top: 48px;
    }
    .pill {
      display: none;
    }
  }
</style>
