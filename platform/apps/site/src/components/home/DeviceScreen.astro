---
// The device's screen, drawn at 640 × 360 and scaled to whatever box holds it.
// Content mirrors the firmware's notification screen.
interface Props {
  variant: 'review' | 'calendar'
}
const { variant } = Astro.props
---

<div class="screen" data-variant={variant}>
  <div class="frame">
    <div class="bar">
      <span class="brand">MOSAIC</span>
      <span class="status">
        <span class="dots"><i class="on"></i><i></i><i></i></span>
        <span>9:50</span>
      </span>
    </div>

    <div class="item review">
      <div class="source">
        <span class="icon">
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><circle cx="18" cy="18" r="3"></circle><circle
              cx="6"
              cy="6"
              r="3"></circle><path d="M13 6h3a2 2 0 0 1 2 2v7"></path><path
              d="M6 9v12"></path></svg
          >
        </span>
        <span class="name">GitHub</span>
        <span class="muted">mosaic-device/mosaic</span>
      </div>
      <div class="title">Avery requested your review</div>
      <div class="detail">
        Show and run notification actions on the device · #194
      </div>
      <div class="meta">
        <span class="add">+412</span><span class="del">−88</span><span
          >12 files</span
        ><span>2 min ago</span>
      </div>
      <div class="spacer"></div>
      <div class="actions">
        <span class="act primary">Approve</span>
        <span class="act">Open on laptop</span>
        <span class="act plain">Dismiss</span>
      </div>
    </div>

    <div class="item calendar">
      <div class="source">
        <span class="icon">
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><rect x="3" y="4" width="18" height="18" rx="2"></rect><path
              d="M16 2v4"></path><path d="M8 2v4"></path><path d="M3 10h18"
            ></path></svg
          >
        </span>
        <span class="name">Google Calendar</span>
        <span class="muted">10:00 – 10:15</span>
      </div>
      <div class="title">Firmware standup</div>
      <div class="countdown">in 4 min</div>
      <div class="spacer"></div>
      <div class="actions">
        <span class="act primary">Join on laptop</span>
        <span class="act">Snooze 5 min</span>
        <span class="act plain">Dismiss</span>
      </div>
    </div>
  </div>
</div>

<style>
  .screen {
    container-type: inline-size;
    width: 100%;
    height: 100%;
    background: var(--color-background);
    overflow: hidden;
  }
  /* One screen pixel at the current size. */
  .frame {
    --s: calc(100cqw / 640);
    position: relative;
    box-sizing: border-box;
    height: calc(360 * var(--s));
    padding: calc(22 * var(--s)) calc(26 * var(--s));
    color: var(--color-foreground);
    font-family: var(--font-family-sans);
    font-size: calc(13 * var(--s));
    line-height: 1.45;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .brand {
    font-family: var(--font-family-brand);
    font-weight: 500;
    letter-spacing: 0.34em;
  }
  .status {
    display: flex;
    align-items: center;
    gap: calc(12 * var(--s));
    color: var(--color-muted-foreground);
  }
  .dots {
    display: flex;
    gap: calc(4 * var(--s));
  }
  .dots i {
    width: calc(4 * var(--s));
    height: calc(4 * var(--s));
    border-radius: calc(2 * var(--s));
    background: var(--color-low-emphasis);
  }
  .dots i.on {
    width: calc(14 * var(--s));
    background: var(--color-foreground);
  }

  /* Both items are always there; the variant decides which one shows, with a fade. */
  .item {
    position: absolute;
    inset: calc(70 * var(--s)) calc(26 * var(--s)) calc(22 * var(--s));
    display: flex;
    flex-direction: column;
    transition: opacity 400ms ease;
  }
  .screen:not([data-variant='review']) .review,
  .screen:not([data-variant='calendar']) .calendar {
    opacity: 0;
  }
  .source {
    display: flex;
    align-items: center;
    gap: calc(10 * var(--s));
  }
  .icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: calc(28 * var(--s));
    height: calc(28 * var(--s));
    border-radius: calc(8 * var(--s));
    background: var(--color-surface-raised);
  }
  .icon svg {
    width: calc(16 * var(--s));
    height: calc(16 * var(--s));
  }
  .name {
    font-weight: 500;
  }
  .muted {
    color: var(--color-muted-foreground);
  }
  .title {
    margin-top: calc(16 * var(--s));
    font-size: calc(30 * var(--s));
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .detail {
    margin-top: calc(8 * var(--s));
    font-size: calc(16 * var(--s));
    color: var(--color-muted-foreground);
  }
  .meta {
    display: flex;
    gap: calc(12 * var(--s));
    margin-top: calc(10 * var(--s));
    color: var(--color-muted-foreground);
  }
  .add {
    color: var(--color-success);
  }
  .del {
    color: var(--color-danger);
  }
  .countdown {
    margin-top: calc(10 * var(--s));
    font-size: calc(64 * var(--s));
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .spacer {
    flex: 1;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: calc(10 * var(--s));
  }
  .act {
    display: flex;
    align-items: center;
    box-sizing: border-box;
    height: calc(44 * var(--s));
    padding: 0 calc(20 * var(--s));
    border: 1px solid var(--color-border);
    border-radius: calc(8 * var(--s));
    background: var(--color-surface);
    font-size: calc(15 * var(--s));
    font-weight: 500;
  }
  .act.primary {
    padding: 0 calc(22 * var(--s));
    border-color: transparent;
    background: var(--color-primary);
    color: var(--color-primary-foreground);
  }
  .act.plain {
    padding: 0 calc(14 * var(--s));
    border-color: transparent;
    background: none;
    color: var(--color-muted-foreground);
  }
</style>
