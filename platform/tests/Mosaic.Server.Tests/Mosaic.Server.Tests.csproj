<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.1" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../apps/server/Mosaic.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared with the firmware host test so both sides check the same bytes. -->
    <None Include="../../packages/protocols/testdata/frames.txt" Link="testdata/frames.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../firmware/components/device_protos/generated/events.pb.h" Link="testdata/events.pb.h" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
